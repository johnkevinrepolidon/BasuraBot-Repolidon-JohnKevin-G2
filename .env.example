# Copy this file to .env and fill in your own values. NEVER commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (local) or Supabase (Project Settings > Database > Connection info)
DB_NAME=basurabot
DB_USER=postgres
DB_PASSWORD=your-password
DB_HOST=localhost
DB_PORT=5432
# Use "require" for Supabase, "prefer" for local PostgreSQL
DB_SSLMODE=prefer
